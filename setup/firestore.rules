rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Must be readable while signed out, to resolve a typed username into
    // an email before signInWithEmailAndPassword can even be attempted.
    match /usernames/{username} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Iteration 1's infra round-trip test docs. No case/sample data model
    // yet -- role-based rules for that come once it exists.
    match /ping/{docId} {
      allow read, write: if isSignedIn();
    }
    match /test_ping/{docId} {
      allow read, write: if isSignedIn();
    }
  }
}
