rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function myRole() {
      return isSignedIn() ? myProfile().role : null;
    }
    function myUsername() {
      return myProfile().username;
    }
    function isAdmin() {
      return myRole() == 'admin';
    }
    // Used only for the users collection itself (admin needs the full list
    // for user management; team_leader/worker need it for case-manager
    // pickers) -- NOT for case/sample/action access, see isCaseStaff().
    function isStaff() {
      return myRole() in ['admin', 'team_leader', 'worker'];
    }
    // 0.4.1: admin has zero rule-level access to case data, not even read
    // (closing the gap Iteration 4 left open -- see HANDOFF.md/SPEC.md).
    // Case work is internal to the lab team; clients get their own,
    // separately-scoped read rule below instead of being lumped in here.
    function isCaseStaff() {
      return myRole() in ['team_leader', 'worker'];
    }
    function clientBelongsToMyOrg(clientId) {
      return clientId != null
        && get(/databases/$(database)/documents/clients/$(clientId)).data.clientOrgId == myProfile().clientOrgId;
    }

    // Must be readable while signed out, to resolve a typed username into
    // an email before signInWithEmailAndPassword can even be attempted.
    match /usernames/{username} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{uid} {
      // Widened from admin-or-self (2026-09-18): picking a case manager
      // needs a list of team_leader/worker usernames, which means any
      // staff member needs to read the whole users collection, not just
      // their own doc. Usernames/roles aren't sensitive within the team.
      allow read: if isSignedIn() && (request.auth.uid == uid || isStaff());
      allow create, update: if isAdmin();
      // Changed 2026-09-18: admin can now delete a user's Firestore
      // profile doc (including automatically for reissue's old account --
      // see admin-ui.js). This does NOT delete the underlying Firebase
      // Auth credential itself -- that still needs the Admin SDK (Blaze),
      // same constraint as ever. Deleting the profile doc is still a real
      // lockout though: every rule here keys off this doc existing, so a
      // signed-in user with no users/{uid} doc can authenticate but reads
      // and writes everywhere else fail closed.
      allow delete: if isAdmin();
    }

    // 0.4.1: admin-managed global lookups. Read is any signed-in staff
    // (team_leader/worker need case types for case creation, and clients
    // for the case's client picker) plus any client account (org/client
    // names aren't sensitive, same reasoning as usernames/roles) -- write
    // is admin-only, matching the admin user-management screen's pattern.
    match /caseTypes/{caseTypeId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    match /clientOrgs/{orgId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /clients/{clientId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /cases/{caseId} {
      // 0.4.1: admin dropped entirely (was isStaff(), which included
      // admin) -- team_leader/worker as before, plus a client-org account
      // reading a case whose client belongs to that same org.
      allow read: if isCaseStaff() || (myRole() == 'client' && clientBelongsToMyOrg(resource.data.client));
      // 0.4.1: narrowed from isLeadOrAdmin() (team_leader-or-admin) to
      // team_leader only, now that admin has no case-data access at all.
      // openedBy is set by the app, not user-entered -- enforced here too,
      // not just trusted client-side.
      allow create: if myRole() == 'team_leader' && request.resource.data.openedBy == myUsername();
      // Broader than create: a case's own caseManager (a worker or
      // team_leader named on the case, not necessarily who opened it)
      // needs to update it day-to-day too.
      allow update: if isCaseStaff() && (myRole() == 'team_leader' || resource.data.caseManager == myUsername());
      // 0.4.1: deletion is now a standalone team-leader judgment call at
      // any stage (was implicitly tied to reaching "done" at the UI
      // level) -- this rule itself is unchanged, since it was already
      // team_leader-only with no admin exception; only the UI-side
      // done-stage restriction is what's being lifted.
      allow delete: if isSignedIn() && myRole() == 'team_leader';

      match /samples/{sampleId} {
        allow read, create, update: if isCaseStaff();
        allow delete: if isSignedIn() && myRole() == 'team_leader';

        match /actions/{actionId} {
          allow read, create, update: if isCaseStaff();
          allow delete: if isSignedIn() && myRole() == 'team_leader';
        }
      }

      match /notes/{noteId} {
        allow read, create, update: if isCaseStaff();
        allow delete: if isSignedIn() && myRole() == 'team_leader';
      }
    }
  }
}
